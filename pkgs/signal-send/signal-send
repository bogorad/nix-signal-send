#!/usr/bin/env bash

state_dir="${SIGNAL_SEND_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/signal-send}"
db="${SIGNAL_SEND_DB:-$state_dir/cli.db3}"
device_name="${SIGNAL_SEND_DEVICE_NAME:-$(hostname)-signal-send}"
discover_timeout="${SIGNAL_SEND_DISCOVER_TIMEOUT:-120}"
project_id=""
group_key_file=""
legacy_group_key_file=""
group_key_source="project"
message_tmp=""

usage() {
  cat >&2 <<'USAGE'
usage:
  signal-send setup
  signal-send setup-device
  signal-send setup-project
  signal-send link
  signal-send sync
  signal-send reset-sessions
  signal-send groups
  signal-send projects
  signal-send select-group
  signal-send discover-group
  signal-send status
  signal-send [--attach PATH ...] MESSAGE
  printf '%s\n' MESSAGE | signal-send [--attach PATH ...]
USAGE
}

ensure_state_dir() {
  mkdir -p "$state_dir" || return $?
  chmod 700 "$state_dir" || return $?
}

find_project_root() {
  local dir
  dir="${PWD:-.}"

  while [[ "$dir" != "/" ]]; do
    if [[ -e "$dir/.git" ]]; then
      printf '%s\n' "$dir"
      return 0
    fi
    dir="${dir%/*}"
    [[ -n "$dir" ]] || dir="/"
  done

  if [[ -e "/.git" ]]; then
    printf '%s\n' "/"
  else
    printf '%s\n' "${PWD:-.}"
  fi
}

sanitize_project_id() {
  awk '{ gsub(/[^A-Za-z0-9_.-]/, "_"); gsub(/^_+|_+$/, ""); print ($0 == "" ? "default" : $0) }' <<<"$1"
}

resolve_project_id() {
  local raw root

  if [[ -n "${SIGNAL_SEND_PROJECT+x}" ]]; then
    if [[ -z "$SIGNAL_SEND_PROJECT" ]]; then
      printf 'signal-send: SIGNAL_SEND_PROJECT is empty\n' >&2
      return 64
    fi
    raw="$SIGNAL_SEND_PROJECT"
  else
    root="$(find_project_root)" || return $?
    raw="${root##*/}"
  fi

  sanitize_project_id "$raw"
}

configure_target() {
  project_id="$(resolve_project_id)" || return $?

  if [[ -n "${SIGNAL_SEND_GROUP_KEY_FILE+x}" ]]; then
    if [[ -z "$SIGNAL_SEND_GROUP_KEY_FILE" ]]; then
      printf 'signal-send: SIGNAL_SEND_GROUP_KEY_FILE is empty\n' >&2
      return 64
    fi
    group_key_source="explicit"
    group_key_file="$SIGNAL_SEND_GROUP_KEY_FILE"
  else
    group_key_source="project"
    group_key_file="$state_dir/projects/$project_id/group_master_key"
    legacy_group_key_file="$state_dir/group_master_key"
  fi
}

ensure_project_state_dir() {
  local project_dir
  ensure_state_dir || return $?
  project_dir="$state_dir/projects/$project_id"
  mkdir -p "$project_dir" || return $?
  chmod 700 "$state_dir/projects" "$project_dir" || return $?
}

presage() {
  presage-cli --sqlite-db-path "$db" "$@"
}

is_registered() {
  presage whoami >/dev/null 2>&1
}

read_group_lines() {
  local output status
  output="$(presage list-groups 2>/dev/null)"
  status=$?
  if [[ "$status" -ne 0 ]]; then
    unset output
    return "$status"
  fi

  awk '/^[0-9a-f]{64} / { print }' <<<"$output"
  status=$?
  unset output
  return "$status"
}

group_count() {
  local lines status
  lines="$(read_group_lines)"
  status=$?
  if [[ "$status" -ne 0 ]]; then
    unset lines
    return "$status"
  fi

  if [[ -z "$lines" ]]; then
    printf '0\n'
    return 0
  fi

  awk 'END { print NR + 0 }' <<<"$lines"
  status=$?
  unset lines
  return "$status"
}

group_label() {
  printf '%s\n' "${1#* }" | awk '{ sub(/ \/ revision .*/, ""); print }'
}

path_has_symlink_component() {
  local path current part
  local -a parts
  path="$1"

  case "$path" in
    /*)
      current="/"
      path="${path#/}"
      ;;
    *)
      current="."
      ;;
  esac

  IFS='/' read -r -a parts <<<"$path"
  for part in "${parts[@]}"; do
    [[ -n "$part" && "$part" != "." ]] || continue
    if [[ "$current" == "/" ]]; then
      current="/$part"
    else
      current="$current/$part"
    fi
    [[ ! -L "$current" ]] || return 0
  done

  return 1
}

active_group_key_file() {
  if uses_legacy_group_key; then
    printf '%s\n' "$legacy_group_key_file"
  else
    printf '%s\n' "$group_key_file"
  fi
}

legacy_group_key_allowed() {
  [[ "$group_key_source" == "project" && "$project_id" == "default" ]]
}

uses_legacy_group_key() {
  legacy_group_key_allowed && [[ ! -s "$group_key_file" && -s "$legacy_group_key_file" ]]
}

cmd_link() {
  ensure_state_dir
  if is_registered; then
    printf 'signal-send: already linked at %s\n' "$db" >&2
    return 0
  fi

  presage link-device --device-name "$device_name" || return $?
  chmod 600 "$db"* 2>/dev/null || true
}

run_sync_steps() {
  local tmp status
  tmp=$1
  status=0
  presage sync-contacts >"$tmp/sync-contacts.out" 2>"$tmp/sync-contacts.err" || status=$?
  if [[ "$status" -eq 0 ]]; then
    presage sync --stop-after-empty-queue >"$tmp/sync.out" 2>"$tmp/sync.err" || status=$?
  fi

  return "$status"
}

print_sync_output_file() {
  local file label line
  label=$1
  file=$2
  if [[ -s "$file" ]]; then
    while IFS= read -r line; do
      printf 'signal-send: %s: %s\n' "$label" "$line" >&2
    done <"$file"
  fi
}

print_sync_diagnostics() {
  local tmp
  tmp=$1
  print_sync_output_file "sync-contacts stderr" "$tmp/sync-contacts.err"
  print_sync_output_file "sync-contacts stdout" "$tmp/sync-contacts.out"
  print_sync_output_file "sync stderr" "$tmp/sync.err"
  print_sync_output_file "sync stdout" "$tmp/sync.out"
}

quiet_sync() {
  local tmp status
  tmp="$(mktemp -d)" || return $?
  run_sync_steps "$tmp"
  status=$?
  if [[ "$status" -ne 0 ]]; then
    printf 'signal-send: sync failed\n' >&2
    print_sync_diagnostics "$tmp"
  fi
  rm -rf "$tmp"
  return "$status"
}

cmd_sync() {
  ensure_state_dir
  quiet_sync
}

cmd_reset_sessions() {
  ensure_state_dir || return $?
  presage reset-sessions
}

cmd_setup_device() {
  ensure_state_dir || return $?
  cmd_link || return $?
  quiet_sync
}

cmd_groups() {
  local line lines status index
  index=1

  lines="$(read_group_lines)"
  status=$?
  if [[ "$status" -ne 0 ]]; then
    printf 'signal-send: unable to list groups; run signal-send sync first\n' >&2
    unset lines
    return "$status"
  fi

  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    printf '%d. %s\n' "$index" "$(group_label "$line")"
    index=$((index + 1))
  done <<<"$lines"
  unset lines

  if [[ "$index" -eq 1 ]]; then
    printf 'signal-send: no groups found; run signal-send discover-group\n' >&2
    return 1
  fi
}

cmd_projects() {
  local dir name found
  found=0

  ensure_state_dir || return $?
  for dir in "$state_dir"/projects/*; do
    [[ -d "$dir" ]] || continue
    found=1
    name="${dir##*/}"
    if [[ -s "$dir/group_master_key" ]]; then
      printf '%s selected\n' "$name"
    else
      printf '%s not-selected\n' "$name"
    fi
  done

  if [[ "$found" -eq 0 ]]; then
    printf 'signal-send: no project group keys found\n' >&2
    return 1
  fi
}

cmd_select_group() {
  local group_output lines line index choice key key_dir tmp status
  if [[ "$group_key_source" == "project" ]]; then
    ensure_project_state_dir || return $?
  else
    ensure_state_dir || return $?
  fi

  group_output="$(read_group_lines)"
  status=$?
  if [[ "$status" -ne 0 ]]; then
    printf 'signal-send: unable to list groups; run signal-send sync first\n' >&2
    unset group_output
    return "$status"
  fi

  if [[ -z "$group_output" ]]; then
    printf 'signal-send: no groups found; run signal-send discover-group\n' >&2
    unset group_output
    return 1
  fi

  mapfile -t lines <<<"$group_output"
  unset group_output

  index=1
  for line in "${lines[@]}"; do
    printf '%d. %s\n' "$index" "$(group_label "$line")"
    index=$((index + 1))
  done

  printf 'Choose group [1-%d]: ' "${#lines[@]}" >&2
  read -r choice

  if ! [[ "$choice" =~ ^[0-9]+$ ]] || (( choice < 1 || choice > ${#lines[@]} )); then
    printf 'signal-send: invalid group choice\n' >&2
    return 64
  fi

  key="${lines[$((choice - 1))]%% *}"
  key_dir="${group_key_file%/*}"
  if [[ "$key_dir" == "$group_key_file" ]]; then
    key_dir="."
  fi

  if [[ "$group_key_source" == "explicit" ]] && path_has_symlink_component "$group_key_file"; then
    printf 'signal-send: group key file is managed or symlinked: %s\n' "$group_key_file" >&2
    printf 'signal-send: run selection before redirecting groupKeyFile, or update the secret source\n' >&2
    return 1
  fi
  if [[ ! -d "$key_dir" || ! -w "$key_dir" ]]; then
    printf 'signal-send: group key directory is not writable: %s\n' "$key_dir" >&2
    printf 'signal-send: run selection before redirecting groupKeyFile, or update the secret source\n' >&2
    return 1
  fi

  tmp="$(mktemp "$key_dir/.signal-send-group-key.XXXXXX")"
  status=$?
  if [[ "$status" -ne 0 ]]; then
    printf 'signal-send: unable to create temporary group key file near: %s\n' "$group_key_file" >&2
    return 1
  fi

  # '$?' inside 'if ! cmd' is the negated status, so these report a fixed
  # failure code rather than capturing 0 and reporting success.
  if ! chmod 0600 "$tmp"; then
    rm -f "$tmp"
    printf 'signal-send: unable to secure temporary group key file: %s\n' "$tmp" >&2
    return 1
  fi
  if ! printf '%s\n' "$key" >"$tmp"; then
    rm -f "$tmp"
    printf 'signal-send: unable to write temporary group key file: %s\n' "$tmp" >&2
    return 1
  fi
  if ! mv -f "$tmp" "$group_key_file"; then
    rm -f "$tmp"
    printf 'signal-send: unable to replace group key file: %s\n' "$group_key_file" >&2
    return 1
  fi
  if ! chmod 0600 "$group_key_file"; then
    printf 'signal-send: unable to secure group key file: %s\n' "$group_key_file" >&2
    return 1
  fi
  if [[ ! -s "$group_key_file" ]]; then
    printf 'signal-send: group key file was not written: %s\n' "$group_key_file" >&2
    return 1
  fi
  printf 'signal-send: selected %s\n' "$(group_label "${lines[$((choice - 1))]}")" >&2
}

cmd_discover_group() {
  local before after deadline pid
  ensure_state_dir
  before="$(group_count)" || return $?
  deadline=$((SECONDS + discover_timeout))

  printf 'signal-send: listening for group activity for up to %s seconds\n' "$discover_timeout" >&2
  printf 'signal-send: send a small message from your phone to the target group now\n' >&2

  presage sync >/dev/null 2>&1 &
  pid="$!"

  while (( SECONDS < deadline )); do
    sleep 2
    after="$(group_count)" || {
      kill "$pid" 2>/dev/null || true
      wait "$pid" 2>/dev/null || true
      return 1
    }
    if (( after > before )); then
      kill "$pid" 2>/dev/null || true
      wait "$pid" 2>/dev/null || true
      cmd_select_group || return $?
      return 0
    fi
  done

  kill "$pid" 2>/dev/null || true
  wait "$pid" 2>/dev/null || true
  printf 'signal-send: no group activity discovered before timeout\n' >&2
  return 1
}

cmd_onboard_project_group() {
  local count
  count="$(group_count)" || return $?
  if [[ "$count" -eq 0 ]]; then
    cmd_discover_group
  else
    cmd_select_group
  fi
}

cmd_setup_project() {
  ensure_project_state_dir || return $?
  if ! is_registered; then
    printf 'signal-send: device is not linked; run signal-send setup-device first\n' >&2
    return 64
  fi

  quiet_sync || return $?
  cmd_onboard_project_group
}

cmd_setup() {
  cmd_setup_device || return $?
  ensure_project_state_dir || return $?
  cmd_onboard_project_group
}

cmd_status() {
  ensure_state_dir

  if is_registered; then
    printf 'linked: yes\n'
  else
    printf 'linked: no\n'
  fi

  printf 'project: %s\n' "$project_id"
  printf 'group-key-source: %s\n' "$group_key_source"
  printf 'db: %s\n' "$db"
  printf 'group-key-file: %s\n' "$group_key_file"
  if uses_legacy_group_key; then
    printf 'legacy-group-key-file: %s\n' "$legacy_group_key_file"
    printf 'group: selected (legacy fallback)\n'
  elif [[ -s "$group_key_file" ]]; then
    printf 'group: selected\n'
  else
    printf 'group: not selected\n'
  fi
}

cleanup_message_tmp() {
  [[ -n "$message_tmp" ]] || return 0
  rm -f "$message_tmp"
  message_tmp=""
}

# Invoked from the signal traps installed in cmd_send.
# shellcheck disable=SC2329
resignal_message_tmp() {
  cleanup_message_tmp
  trap - "$1"
  kill -s "$1" "$$"
}

# Signal limits the message body by encoded size, not by character count, so
# count bytes. LC_ALL=C makes '${#1}' a byte count; 'local' restores the
# caller's locale on return, leaving character-based slicing intact.
message_byte_length() {
  local LC_ALL=C
  printf '%s\n' "${#1}"
}

cmd_send() {
  local attachments message body key key_file message_bytes status
  attachments=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --attach)
        if [[ $# -lt 2 ]]; then
          printf 'signal-send: missing value for --attach\n' >&2
          return 64
        fi
        attachments+=(--attach "$2")
        shift 2
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      --)
        shift
        break
        ;;
      -*)
        printf 'signal-send: unknown option: %s\n' "$1" >&2
        usage
        return 64
        ;;
      *)
        break
        ;;
    esac
  done

  key_file="$(active_group_key_file)"
  if [[ ! -s "$key_file" ]]; then
    if [[ "$group_key_source" == "project" ]]; then
      printf 'signal-send: no selected group for project %s; run signal-send setup-project or signal-send select-group\n' "$project_id" >&2
      if [[ "$project_id" != "default" && -s "$legacy_group_key_file" ]]; then
        printf 'signal-send: legacy key at %s is only used for project default\n' "$legacy_group_key_file" >&2
      fi
    else
      printf 'signal-send: no selected group; check SIGNAL_SEND_GROUP_KEY_FILE\n' >&2
    fi
    return 64
  fi

  key="$(tr -d '[:space:]' <"$key_file")"
  if ! [[ "$key" =~ ^[0-9a-f]{64}$ ]]; then
    printf 'signal-send: group key file is not a 64-character hex key\n' >&2
    return 65
  fi

  if [[ $# -gt 0 ]]; then
    message="$*"
  else
    message="$(cat)"
  fi

  if [[ -z "$message" ]]; then
    printf 'signal-send: empty message\n' >&2
    return 64
  fi

  body="$message"
  message_bytes="$(message_byte_length "$message")"
  if ((message_bytes > 2000)); then
    # Register cleanup before the file exists so an interrupt cannot strand
    # message plaintext in TMPDIR.
    trap cleanup_message_tmp EXIT
    trap 'resignal_message_tmp INT' INT
    trap 'resignal_message_tmp TERM' TERM
    trap 'resignal_message_tmp HUP' HUP

    message_tmp="$(mktemp "${TMPDIR:-/tmp}/signal-send-message.XXXXXX.txt")" || return $?
    chmod 0600 "$message_tmp" || return $?
    printf '%s' "$message" >"$message_tmp" || return $?

    body="${message:0:200}[...]"
    attachments+=(--attach "$message_tmp")
    printf 'signal-send: message size %d bytes > 2000; sending full text as attachment\n' "$message_bytes" >&2
  fi

  status=0
  presage send-to-group \
    --master-key "$key" \
    --message "$body" \
    "${attachments[@]}" || status=$?

  cleanup_message_tmp
  return "$status"
}

main() {
  local command
  command="${1:-send}"

  case "$command" in
    setup)
      shift
      [[ $# -eq 0 ]] || { usage; return 64; }
      cmd_setup
      ;;
    setup-device)
      shift
      [[ $# -eq 0 ]] || { usage; return 64; }
      cmd_setup_device
      ;;
    setup-project)
      shift
      [[ $# -eq 0 ]] || { usage; return 64; }
      cmd_setup_project
      ;;
    link)
      shift
      [[ $# -eq 0 ]] || { usage; return 64; }
      cmd_link
      ;;
    sync)
      shift
      [[ $# -eq 0 ]] || { usage; return 64; }
      cmd_sync
      ;;
    reset-sessions)
      shift
      [[ $# -eq 0 ]] || { usage; return 64; }
      cmd_reset_sessions
      ;;
    groups)
      shift
      [[ $# -eq 0 ]] || { usage; return 64; }
      cmd_groups
      ;;
    projects)
      shift
      [[ $# -eq 0 ]] || { usage; return 64; }
      cmd_projects
      ;;
    select-group)
      shift
      [[ $# -eq 0 ]] || { usage; return 64; }
      cmd_select_group
      ;;
    discover-group)
      shift
      [[ $# -eq 0 ]] || { usage; return 64; }
      cmd_discover_group
      ;;
    status)
      shift
      [[ $# -eq 0 ]] || { usage; return 64; }
      cmd_status
      ;;
    send)
      if [[ $# -gt 0 ]]; then
        shift
      fi
      cmd_send "$@"
      ;;
    -h|--help|help)
      usage
      ;;
    *)
      cmd_send "$@"
      ;;
  esac
}

configure_target || exit $?
main "$@"
exit $?
